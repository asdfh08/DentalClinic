<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Вкладка "Врачи": связанная сущность и записи к выбранному врачу. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.dentalclinic.fx.controller.DentistsController"
            styleClass="page">
    <top>
        <HBox styleClass="toolbar">
            <Label text="Врачи-стоматологи" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="dentistsCountLabel" styleClass="count-label"/>
            <Button text="Обновить" onAction="#onRefresh"/>
        </HBox>
    </top>
    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.45" styleClass="content-split">
            <TableView fx:id="dentistsTable" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="nameColumn" text="ФИО" prefWidth="280"/>
                    <TableColumn fx:id="specializationColumn" text="Специализация" prefWidth="240"/>
                    <TableColumn fx:id="cabinetColumn" text="Кабинет" prefWidth="90"/>
                    <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="150"/>
                </columns>
                <placeholder>
                    <Label text="В базе данных нет врачей"/>
                </placeholder>
            </TableView>
            <VBox styleClass="related-box">
                <Label fx:id="dentistAppointmentsTitle" styleClass="section-title"/>
                <TableView fx:id="dentistAppointmentsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="timeColumn" text="Дата и время" prefWidth="140"/>
                        <TableColumn fx:id="patientColumn" text="Пациент" prefWidth="240"/>
                        <TableColumn fx:id="procedureColumn" text="Процедура" prefWidth="200"/>
                        <TableColumn fx:id="statusColumn" text="Статус" prefWidth="120"/>
                        <TableColumn fx:id="priceColumn" text="Стоимость" prefWidth="130"/>
                    </columns>
                    <placeholder>
                        <Label fx:id="dentistAppointmentsPlaceholder" text="Выберите врача в таблице выше"/>
                    </placeholder>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
