<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Диалоговое окно добавления и редактирования записи на приём. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.dentalclinic.fx.controller.AppointmentFormController"
      styleClass="form" prefWidth="600">
    <Label fx:id="titleLabel" styleClass="form-title"/>

    <GridPane styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="150" prefWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Пациент *" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="patientBox" maxWidth="Infinity" promptText="Выберите пациента"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Врач *" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="dentistBox" maxWidth="Infinity" promptText="Выберите врача"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Дата приёма *" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="datePicker" maxWidth="Infinity" promptText="ДД.ММ.ГГГГ"
                    GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Время начала *" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="timeBox" editable="true" maxWidth="Infinity" promptText="ЧЧ:ММ, например 10:30"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Процедура *" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="procedureBox" maxWidth="Infinity" promptText="Выберите процедуру"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Стоимость, руб." styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="priceField" promptText="пусто — цена по прайсу"
                   GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label fx:id="statusLabel" text="Статус *" styleClass="field-label"
               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <ComboBox fx:id="statusBox" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Жалоба" styleClass="field-label" GridPane.rowIndex="7" GridPane.columnIndex="0"
               GridPane.valignment="TOP"/>
        <VBox spacing="4" GridPane.rowIndex="7" GridPane.columnIndex="1">
            <TextArea fx:id="complaintArea" prefRowCount="3" wrapText="true"
                      promptText="Необязательно: что беспокоит пациента"/>
            <Label fx:id="complaintCounter" styleClass="hint-label"/>
        </VBox>
    </GridPane>

    <Label fx:id="hintLabel" styleClass="hint-label" wrapText="true"/>
    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

    <HBox styleClass="form-buttons">
        <Label text="* — обязательные поля" styleClass="hint-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Отмена" cancelButton="true" onAction="#onCancel"/>
        <Button fx:id="saveButton" text="Сохранить" defaultButton="true" onAction="#onSave"
                styleClass="button-primary"/>
    </HBox>
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>
</VBox>
